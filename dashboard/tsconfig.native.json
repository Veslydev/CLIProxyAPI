{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@native/*": ["./native/*"],
      "next/navigation": ["./native/navigation.tsx"],
      "next/link": ["./native/link.tsx"],
      "next/image": ["./native/image.tsx"],
      "next/dynamic": ["./native/dynamic.tsx"],
      "next-intl": ["./native/intl.ts"]
    }
  },
  "include": ["native/**/*.ts", "native/**/*.tsx"]
}
